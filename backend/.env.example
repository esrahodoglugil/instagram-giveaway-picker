# Sunucu portu (varsayılan 3001)
PORT=3001

# ---------------------------------------------------------------------------
# Instagram (sadece SUNUCU modu: postUrl ile yorum çekme, /post-owner vb.)
# Extension / client modunda (body.comments) bu değerler ZORUNLU DEĞİL.
# ---------------------------------------------------------------------------

# Önerilen: DevTools → Application → Cookies → https://www.instagram.com
# Önemli çerezleri tek satırda birleştirin (tırnak yok); örnek:
# INSTAGRAM_COOKIE=sessionid=...; csrftoken=...; mid=...; ig_did=...; ds_user_id=...; datr=...
INSTAGRAM_COOKIE=

# Alternatif (INSTAGRAM_COOKIE yoksa):
# INSTAGRAM_SESSION_ID=
# INSTAGRAM_CSRF_TOKEN=
# INSTAGRAM_DS_USER_ID=

# Opsiyonel: arayüzde gösterilecek kullanıcı adı (yoksa ds_user_id veya varsayılan metin)
# INSTAGRAM_USERNAME=
